{
    "version": 2,
    "builds": [
        {
            "src": "api/analyze.py",
            "use": "@vercel/python"
        },
        {
            "src": "api/generate-report.js",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/api/analyze",
            "dest": "/api/analyze.py"
        },
        {
            "src": "/api/generate-report",
            "dest": "/api/generate-report.js"
        }
    ],
    "functions": {
        "api/analyze.py": {
            "maxDuration": 10
        },
        "api/generate-report.js": {
            "maxDuration": 30
        }
    }
}